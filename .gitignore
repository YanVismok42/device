.wrangler/

# База прошлой, Node-версии (осталась от локальных запусков).
data/
*.tmp

# Вторая версия (тема Nothing) — хостим только основную.
nothing/

# Локальные настройки редактора
.claude/

# Логи и системный мусор
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.local

# Локальные секреты wrangler dev
.dev.vars
